<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>kDriveClientIcon.ico</ApplicationIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Authors>Anthony Chaussin</Authors>
    <Description>kDriveClient is a modern C# SDK for the Infomaniak kDrive API: parallel chunked upload, download, typed endpoints, DI support, and built-in rate limiting.</Description>
    <Copyright>Copyright (c) 2025 Anthony Chaussin</Copyright>
    <PackageProjectUrl>https://github.com/anthonychaussin/DriveClient</PackageProjectUrl>
    <PackageIcon>kDriveClientIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/anthonychaussin/DriveClient</RepositoryUrl>
    <PackageTags>infomaniak;kDrive;wrapper;c#;DotNet</PackageTags>
    <PackageReleaseNotes>2.0.0
- Unified HTTP pipeline with a single shared rate limiter
- Real parallel chunked uploads (Parallelism)
- Domain interfaces: IKDriveUpload, IKDriveDownload, IKDriveFiles, IKDriveShares, …
- KDriveClient.CreateAsync + AddKDriveClient DI registration
- Removed KDriveFileUploader, Newtonsoft.Json
- Renamed KDriveUploadResponseWrapper / fixed typos</PackageReleaseNotes>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <IncludeSymbols>True</IncludeSymbols>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <TrimmerDefaultAction>link</TrimmerDefaultAction>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="infomaniak_api_kdrive.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="kDriveClientIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <None Update="kDriveClientIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
